# The fork commits the publish workflow builds images from. Sourced by
# .argoci/scripts/publish/env.sh. A fork's change is published only once a PR
# here moves its commit.
# Each commit must be on the branch named beside it, or the build fails.

MUST_GATHER_BRANCH=main
MUST_GATHER_SHA=bf896bb0ef686d418933f4cd4690d70fa66fa4ca

# The console loader changed at 4.22, so each console era has its own plugin.
# The plugin for consoles up to 4.21 only exists on release branches.
CONSOLE_PLUGIN_OCP421_BRANCH=rel/v3.24.0-3-ocp421
CONSOLE_PLUGIN_OCP421_SHA=b5bcf6e33ce29894638b68ebadb35ec408c80cf8
CONSOLE_PLUGIN_OCP422_BRANCH=main
CONSOLE_PLUGIN_OCP422_SHA=9f489832e580fad349d625b0df8c1ab5c8a44f36
